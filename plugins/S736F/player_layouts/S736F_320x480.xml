<component>
    <animations>
        <timeline name="lyrics_open">
            <animation prop="translate_y" target="title" start="0" end="-18" duration="260" />
            <animation prop="translate_y" target="artist" start="0" end="-162" duration="260" />
            <animation prop="opa" target="cover_card" start="255" end="0" duration="180" />
            <animation prop="opa" target="album" start="255" end="0" duration="180" />
            <animation prop="opa" target="quality_pill" start="255" end="0" duration="180" />
            <animation prop="opa" target="favorite_circle" start="255" end="0" duration="180" />
            <animation prop="opa" target="song_count" start="255" end="0" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="255" end="0" duration="80" />
        </timeline>
        <timeline name="lyrics_close">
            <animation prop="translate_y" target="title" start="-18" end="0" duration="260" />
            <animation prop="translate_y" target="artist" start="-162" end="0" duration="260" />
            <animation prop="opa" target="cover_card" start="0" end="255" duration="180" />
            <animation prop="opa" target="album" start="0" end="255" duration="180" />
            <animation prop="opa" target="quality_pill" start="0" end="255" duration="180" />
            <animation prop="opa" target="favorite_circle" start="0" end="255" duration="180" />
            <animation prop="opa" target="song_count" start="0" end="255" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
        </timeline>
    </animations>
    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_color="0x000000" style_bg_opa="0" style_text_color="0xf2f3f4" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_label name="title" text="" x="20" y="62" width="280" height="content" style_text_font="font_22" style_text_color="0xf2f3f4" style_text_align="left" style_pad_all="0" />
        <lv_obj name="cover_card" x="20" y="96" width="130" height="130" scrollable="false" style_radius="14" style_clip_corner="true" style_bg_color="0x000000" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="cover_img" src="default_cover" width="100%" height="100%" align="center" inner_align="cover" />
        </lv_obj>
        <lv_label name="artist" text="" x="20" y="236" width="280" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="left" style_pad_all="0" />
        <lv_label name="album" text="" x="20" y="262" width="280" height="content" style_text_font="font_16" style_text_color="0x7d858c" style_text_align="left" style_pad_all="0" />
        <lv_obj name="dismiss_btn" x="0" y="32" width="48" height="48" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="dismiss_icon" src="btn_back" x="12" y="12" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_image name="more_btn" src="ic_more" x="273" y="421" width="30" height="30" inner_align="contain" />
        <lv_label name="song_count" text="" x="20" y="288" width="160" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="left" style_pad_all="0" />
        <lv_obj name="quality_pill" x="20" y="325" width="224" height="28" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_label name="format_badge" text="" x="0" y="2" width="100%" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="left" style_pad_all="0" />
        </lv_obj>
        <lv_obj name="favorite_circle" x="252" y="317" width="44" height="44" scrollable="false" style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="favorite_icon" src="collect_out" width="32" height="32" align="center" inner_align="contain" />
        </lv_obj>
        <lv_obj name="lyrics_area" x="24" y="112" width="272" height="249" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_text_color="0xaab1b8" style_text_align="center" clickable="false" />
        <lv_slider name="progress_slider" x="20" y="377" width="280" height="14" style_bg_color="0x46515b" style_bg_opa="255" style_radius="7" />
        <lv_label name="pos_label" text="0:00" x="20" y="393" width="80" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="left" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="220" y="393" width="80" height="content" style_text_font="font_16" style_text_color="0xaab1b8" style_text_align="right" style_pad_all="0" />
        <lv_image name="order_btn" src="order" x="17" y="421" width="30" height="30" inner_align="contain" />
        <lv_image name="prev_btn" src="btn_prev" x="81" y="421" width="30" height="30" inner_align="contain" />
        <lv_obj name="play_circle" x="131" y="407" width="58" height="58" scrollable="false" style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="play_btn" src="btn_play" x="0" y="0" width="58" height="58" inner_align="contain" />
        </lv_obj>
        <lv_image name="next_btn" src="btn_next" x="209" y="421" width="30" height="30" inner_align="contain" />
        <lv_slider name="volume_slider" width="100" height="10" hidden="true" />
    </view>
</component>
