            <animation prop="translate_y" target="artist" start="-159" end="0" duration="260" />
            <animation prop="width" target="artist" start="164" end="106" duration="260" />
            <animation prop="translate_x" target="album" start="52" end="0" duration="260" />
            <animation prop="translate_y" target="album" start="-156" end="0" duration="260" />
