            <animation prop="opa" target="more_btn" start="0" end="255" duration="180" />
            <animation prop="opa" target="progress_slider" start="0" end="255" duration="180" />
            <animation prop="opa" target="pos_label" start="0" end="255" duration="180" />
            <animation prop="opa" target="dur_label" start="0" end="255" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
        </timeline>
    </animations>
