<component>
    <animations>
        <timeline name="lyrics_open">
            <animation prop="width" target="title" start="216" end="142" duration="260" />
            <animation prop="width" target="artist" start="216" end="170" duration="260" />
            <animation prop="translate_x" target="title" start="0" end="46" duration="260" />
            <animation prop="translate_y" target="title" start="0" end="-125" duration="260" />
            <animation prop="translate_x" target="artist" start="0" end="46" duration="260" />
            <animation prop="translate_y" target="artist" start="0" end="-127" duration="260" />
            <animation prop="opa" target="cover_thumbnail" start="0" end="255" duration="220" delay="40" />
            <animation prop="bg_opa" target="lyrics_area" start="0" end="230" duration="220" />
            <animation prop="opa" target="quality_pill" start="255" end="0" duration="180" />
            <animation prop="opa" target="song_count" start="255" end="0" duration="180" />
            <animation prop="opa" target="progress_slider" start="255" end="0" duration="180" />
            <animation prop="opa" target="pos_label" start="255" end="0" duration="180" />
            <animation prop="opa" target="dur_label" start="255" end="0" duration="180" />
            <animation prop="bg_opa" target="lyrics_dim" start="0" end="160" duration="220" />
            <animation prop="opa" target="dismiss_btn" start="255" end="0" duration="80" />
            <animation prop="opa" target="album" start="255" end="0" duration="180" />
        </timeline>
        <timeline name="lyrics_close">
            <animation prop="width" target="title" start="142" end="216" duration="260" />
            <animation prop="width" target="artist" start="170" end="216" duration="260" />
            <animation prop="translate_x" target="title" start="46" end="0" duration="260" />
            <animation prop="translate_y" target="title" start="-125" end="0" duration="260" />
            <animation prop="translate_x" target="artist" start="46" end="0" duration="260" />
            <animation prop="translate_y" target="artist" start="-127" end="0" duration="260" />
            <animation prop="opa" target="cover_thumbnail" start="255" end="0" duration="160" />
            <animation prop="bg_opa" target="lyrics_area" start="230" end="0" duration="220" />
            <animation prop="opa" target="quality_pill" start="0" end="255" duration="200" delay="80" />
            <animation prop="opa" target="song_count" start="0" end="255" duration="200" delay="80" />
            <animation prop="opa" target="progress_slider" start="0" end="255" duration="200" delay="80" />
            <animation prop="opa" target="pos_label" start="0" end="255" duration="200" delay="80" />
            <animation prop="opa" target="dur_label" start="0" end="255" duration="200" delay="80" />
            <animation prop="bg_opa" target="lyrics_dim" start="160" end="0" duration="220" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
            <animation prop="opa" target="album" start="0" end="255" duration="180" />
        </timeline>
    </animations>
    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_opa="255" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_obj name="lyrics_backdrop" x="0" y="0" width="240" height="320" scrollable="false" clickable="false" style_bg_opa="255" style_border_width="0" style_radius="0" style_pad_all="0">
            <lv_obj name="cover_card" x="0" y="0" width="240" height="240" scrollable="false" style_radius="0" style_clip_corner="true" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
                <lv_image name="cover_img" src="default_cover" align="center" />
                <lv_image name="cover_fade" x="0" y="0" width="240" height="240" inner_align="stretch" />
            </lv_obj>
            <lv_obj name="lyrics_dim" x="0" y="0" width="240" height="240" scrollable="false" clickable="false" style_bg_opa="0" style_opa="255" style_border_width="0" style_radius="0" style_pad_all="0" />
            <lv_obj name="lyrics_area" x="12" y="80" width="216" height="184" scrollable="false" style_bg_opa="0" style_opa="255" style_radius="16" style_border_width="0" style_pad_all="12" style_text_align="left" clickable="false" />
        </lv_obj>
        <lv_obj name="dismiss_btn" x="4" y="4" width="32" height="32" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="dismiss_icon" src="btn_back" x="4" y="4" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_image name="more_btn" src="ic_more" x="204" y="8" width="24" height="24" inner_align="contain" />
        <lv_label name="title" text="" x="12" y="151" width="216" height="22" style_text_font="font_20" style_text_align="left" style_pad_all="0" />
        <lv_label name="artist" text="" x="12" y="179" width="216" height="18" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
        <lv_label name="album" text="" x="12" y="201" width="216" height="18" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
        <lv_image name="cover_thumbnail" src="default_cover" x="12" y="12" width="40" height="40" inner_align="contain" style_opa="0" />
        <lv_label name="song_count" text="" x="12" y="222" width="50" height="22" style_text_font="font_16" style_pad_all="0" />
        <lv_obj name="quality_pill" x="66" y="220" width="162" height="24" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_label name="format_badge" text="" x="0" y="0" width="100%" height="24" style_text_font="font_16" style_text_align="center" style_pad_all="0" />
        </lv_obj>
        <lv_obj name="favorite_circle" x="200" y="281" width="32" height="32" scrollable="false" style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="favorite_icon" src="collect_out" x="4" y="4" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_label name="seek_style" text="waveform_bars" x="0" y="0" width="1" height="1" style_opa="0" clickable="false" />
        <lv_slider name="progress_slider" x="12" y="244" width="216" height="16" style_radius="6" />
        <lv_label name="pos_label" text="0:00" x="12" y="264" width="72" height="18" style_text_font="font_16" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="156" y="264" width="72" height="18" style_text_font="font_16" style_text_align="right" style_pad_all="0" />
        <lv_image name="order_btn" src="order" x="12" y="285" width="24" height="24" inner_align="contain" />
        <lv_image name="prev_btn" src="btn_prev" x="56" y="285" width="24" height="24" inner_align="contain" />
        <lv_obj name="play_circle" x="100" y="277" width="40" height="40" scrollable="false" style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="play_btn" src="btn_play" x="0" y="0" width="40" height="40" inner_align="contain" />
        </lv_obj>
        <lv_image name="next_btn" src="btn_next" x="160" y="285" width="24" height="24" inner_align="contain" />
        <lv_slider name="volume_slider" width="100" height="10" hidden="true" />
    </view>
</component>
