<!-- 320x480 Reading Room layout. All controls stay inside the safe screen area. -->
<component>
  <consts>
    <bool name="compas_lyrics_enabled" value="false"/>
    <str name="compas_artist_action" value="none"/>
    <str name="compas_album_action" value="reading_menu"/>
  </consts>
  <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_opa="255" style_border_width="0" style_pad_all="0">
    <lv_obj name="cover_card" x="91" y="39" width="138" height="138"
            scrollable="false" style_radius="18" style_clip_corner="true" style_bg_opa="255" style_border_width="0" style_pad_all="0">
      <lv_image name="cover_img" src="default_cover" width="138" height="138" align="center" inner_align="stretch"/>
    </lv_obj>
    <lv_label name="title" text="" x="24" y="181" width="272" height="content" long_mode="dots" style_text_align="center" style_text_font="player_title"/>
    <lv_label name="artist" text="" x="24" y="211" width="272" height="content" long_mode="dots" style_text_align="center" style_text_font="player_meta"/>
    <lv_label name="album" text="" x="24" y="235" width="272" height="content" long_mode="dots" style_text_align="center" style_text_font="player_meta"/>
    <lv_slider name="progress_slider" x="24" y="266" width="272" height="12" style_radius="6"/>
    <lv_label name="pos_label" text="0:00" x="24" y="284" width="90" height="22"/>
    <lv_label name="dur_label" text="--:--" x="206" y="284" width="90" height="22" style_text_align="right"/>

    <!-- Main transport: the 15-second actions flank the centered play control. -->
    <lv_button name="rewind_button" x="42" y="309" width="60" height="56" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image name="glyph_rewind" src="rr_rewind" width="48" height="48" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="rewind_15"/>
    </lv_button>
    <lv_image name="play_btn" src="btn_play" x="136" y="313" width="48" height="48"
              inner_align="contain"/>
    <lv_button name="forward_button" x="218" y="309" width="60" height="56" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image name="glyph_forward" src="rr_forward" width="48" height="48" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="forward_15"/>
    </lv_button>

    <!-- Secondary row: previous chapter, speed, next chapter. -->
    <lv_image name="prev_btn" src="btn_prev" x="48" y="366" width="48" height="48"
              inner_align="contain"/>
    <lv_button name="speed_button" x="136" y="366" width="48" height="48" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image name="glyph_speed" src="rr_speed" width="44" height="44" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="speed_menu"/>
    </lv_button>
    <lv_image name="next_btn" src="btn_next" x="224" y="366" width="48" height="48"
              inner_align="contain"/>
    <lv_label name="caption_speed" text="Speed" x="128" y="417" width="64" height="28" style_text_align="center" style_text_font="font_16"/>
  </view>
</component>
