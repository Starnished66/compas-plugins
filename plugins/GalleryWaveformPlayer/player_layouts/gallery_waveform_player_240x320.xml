        <lv_obj name="lyrics_area" x="12" y="68" width="216" height="160" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_text_align="center" clickable="false" />
        <lv_slider name="progress_slider" x="12" y="232" width="216" height="16" style_radius="4" />
        <lv_label name="pos_label" text="0:00" x="12" y="251" width="70" height="18" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="158" y="251" width="70" height="18" style_text_font="font_16" style_text_align="right" style_pad_all="0" />
        <lv_image name="prev_btn" src="btn_prev" x="62" y="279" width="24" height="24" inner_align="contain" />
