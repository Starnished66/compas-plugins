<component>
    <animations>
        <timeline name="lyrics_open">
            <animation prop="width" target="cover_card" start="128" end="40" duration="260" />
            <animation prop="height" target="cover_card" start="128" end="40" duration="260" />
            <animation prop="translate_x" target="cover_card" start="0" end="-44" duration="260" />
            <animation prop="translate_y" target="cover_card" start="0" end="8" duration="260" />
            <animation prop="translate_y" target="title" start="0" end="-133" duration="260" />
            <animation prop="translate_y" target="artist" start="0" end="-137" duration="260" />
            <animation prop="translate_x" target="title" start="0" end="52" duration="260" />
            <animation prop="translate_x" target="artist" start="0" end="52" duration="260" />
            <animation prop="width" target="title" start="216" end="164" duration="260" />
            <animation prop="width" target="artist" start="216" end="164" duration="260" />
            <animation prop="opa" target="quality_pill" start="255" end="0" duration="180" />
            <animation prop="opa" target="favorite_circle" start="255" end="0" duration="180" />
            <animation prop="opa" target="song_count" start="255" end="0" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="255" end="0" duration="80" />
            <animation prop="text_align" target="title" start="1" end="0" duration="1" early_apply="false" />
            <animation prop="text_align" target="artist" start="1" end="0" duration="1" early_apply="false" />
        </timeline>
        <timeline name="lyrics_close">
            <animation prop="width" target="cover_card" start="40" end="128" duration="260" />
            <animation prop="height" target="cover_card" start="40" end="128" duration="260" />
            <animation prop="translate_x" target="cover_card" start="-44" end="0" duration="260" />
            <animation prop="translate_y" target="cover_card" start="8" end="0" duration="260" />
            <animation prop="translate_y" target="title" start="-133" end="0" duration="260" />
            <animation prop="translate_y" target="artist" start="-137" end="0" duration="260" />
            <animation prop="translate_x" target="title" start="52" end="0" duration="260" />
            <animation prop="translate_x" target="artist" start="52" end="0" duration="260" />
            <animation prop="width" target="title" start="164" end="216" duration="260" />
            <animation prop="width" target="artist" start="164" end="216" duration="260" />
            <animation prop="opa" target="quality_pill" start="0" end="255" duration="180" />
            <animation prop="opa" target="favorite_circle" start="0" end="255" duration="180" />
            <animation prop="opa" target="song_count" start="0" end="255" duration="180" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />
            <animation prop="text_align" target="title" start="0" end="1" duration="1" early_apply="false" />
            <animation prop="text_align" target="artist" start="0" end="1" duration="1" early_apply="false" />
        </timeline>
    </animations>
