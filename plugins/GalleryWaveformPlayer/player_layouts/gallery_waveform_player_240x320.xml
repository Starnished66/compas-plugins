        <lv_obj name="favorite_circle" x="204" y="198" width="28" height="28" scrollable="false" style_radius="14" style_bg_opa="32" style_bg_color="#000000" style_border_width="0" style_pad_all="0">
            <lv_image name="favorite_icon" src="collect_out" width="24" height="24" align="center" inner_align="contain" />
