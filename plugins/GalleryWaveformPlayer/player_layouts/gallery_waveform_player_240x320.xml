        </lv_obj>
        <lv_obj name="dismiss_btn" x="0" y="4" width="32" height="32" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="dismiss_icon" src="v1_back" x="4" y="4" width="24" height="24" inner_align="contain" />
        </lv_obj>
        <lv_label name="title" text="" x="12" y="149" width="216" height="22" style_text_font="font_20" style_text_align="center" style_pad_all="0" />
        <lv_label name="artist" text="" x="12" y="177" width="216" height="17" style_text_font="font_16" style_text_align="center" style_pad_all="0" />
        <lv_label name="song_count" text="" x="12" y="205" width="35" height="18" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
        <lv_obj name="quality_pill" x="48" y="202" width="144" height="24" scrollable="false" style_radius="12" style_bg_opa="32" style_bg_color="#000000" style_border_width="0" style_pad_all="0" clickable="false">
