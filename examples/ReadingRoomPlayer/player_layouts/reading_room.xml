<!-- 480x800 Reading Room layout. All controls stay inside the safe screen area. -->
<component>
  <consts>
    <bool name="compas_lyrics_enabled" value="false"/>
    <str name="compas_artist_action" value="none"/>
    <str name="compas_album_action" value="reading_menu"/>
  </consts>
  <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false"
        style_bg_color="0x171b19" style_bg_opa="255" style_border_width="0" style_pad_all="0">
    <lv_obj name="cover_card" x="80" y="60" width="320" height="320"
            scrollable="false" style_radius="18" style_clip_corner="true"
            style_bg_color="0x303730" style_bg_opa="255" style_border_width="0" style_pad_all="0">
      <lv_image name="cover_img" src="default_cover" width="320" height="320" align="center" inner_align="stretch"/>
    </lv_obj>
    <lv_label name="title" text="" x="24" y="390" width="432" height="content" long_mode="dots"
              style_text_color="0xe5e2d9" style_text_align="center" style_text_font="player_title"/>
    <lv_label name="artist" text="" x="24" y="448" width="432" height="content" long_mode="dots"
              style_text_color="0xadb7ad" style_text_align="center" style_text_font="player_meta"/>
    <lv_label name="album" text="" x="24" y="480" width="432" height="content" long_mode="dots"
              style_text_color="0xadb7ad" style_text_align="center" style_text_font="player_meta"/>
    <lv_slider name="progress_slider" x="24" y="530" width="432" height="12"
               style_bg_color="0x303730" style_bg_opa="255" style_radius="6"/>
    <lv_label name="pos_label" text="0:00" x="24" y="549" width="90" height="22" style_text_color="0xadb7ad"/>
    <lv_label name="dur_label" text="--:--" x="366" y="549" width="90" height="22" style_text_color="0xadb7ad" style_text_align="right"/>

    <!-- Main transport: the 15-second actions flank the centered play control. -->
    <lv_button name="rewind_button" x="124" y="580" width="72" height="72" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image src="rr_rewind" width="64" height="64" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="rewind_15"/>
    </lv_button>
    <lv_image name="play_btn" src="btn_play" x="208" y="584" width="64" height="64"
              inner_align="contain" style_image_recolor="0xe5e2d9" style_image_recolor_opa="255"/>
    <lv_button name="forward_button" x="284" y="580" width="72" height="72" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image src="rr_forward" width="64" height="64" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="forward_15"/>
    </lv_button>

    <!-- Secondary row: previous chapter, speed, next chapter. -->
    <lv_image name="prev_btn" src="btn_prev" x="122" y="680" width="56" height="56"
              inner_align="contain" style_image_recolor="0xe5e2d9" style_image_recolor_opa="255"/>
    <lv_button name="speed_button" x="212" y="680" width="56" height="56" clickable="true"
               style_radius="0" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_shadow_width="0">
      <lv_image src="rr_speed" width="48" height="48" align="center" inner_align="contain"/>
      <event_cb trigger="clicked" callback="compas_action" user_data="speed_menu"/>
    </lv_button>
    <lv_image name="next_btn" src="btn_next" x="302" y="680" width="56" height="56"
              inner_align="contain" style_image_recolor="0xe5e2d9" style_image_recolor_opa="255"/>
    <lv_label text="Speed" x="202" y="736" width="76" height="28"
              style_text_color="0xadb7ad" style_text_align="center" style_text_font="font_16"/>
  </view>
</component>
